# ═════════════════════════════════════════════════════════════════
#  Echo 2.0 Bot & Web Dashboard — Environment Configuration Template
#  Copy this file to '.env' and fill in your actual credentials.
# ═════════════════════════════════════════════════════════════════

# ── Discord Bot Configuration ─────────────────────────────────────
# Obtain your Bot Token from https://discord.com/developers/applications
BOT_TOKEN=your_discord_bot_token_here

# ── Web Dashboard (Discord OAuth2 Login) ──────────────────────────
# Application Client ID and Secret from Discord Developer Portal -> OAuth2
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# The exact callback URL configured in Discord Developer Portal -> OAuth2 -> Redirects
# Local testing default: http://localhost:3000/auth/callback
# Domain / Production: https://yourdomain.com/auth/callback
DASHBOARD_REDIRECT_URI=http://localhost:3000/auth/callback

# Secret key used to sign session cookies. Generate one via:
#   python -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_SESSION_SECRET=change_this_to_a_random_32_byte_hex_string

# Web server port for the dashboard (Default: 3000)
DASHBOARD_PORT=3000

# Set to "true" to enable Web Dashboard or "false" to disable
DASHBOARD_ENABLED=true

# Public URL of the Dashboard (used for invite links and web buttons)
DASHBOARD_URL=http://localhost:3000

# ── Admin Security Passcode ───────────────────────────────────────
# Secret PIN/Passcode required to unlock Owner Admin Panel (/admin)
ADMIN_PASSCODE=123456

# ── Lavende Audio Engine Cluster ──────────────────────────────────
# High-speed Lavende audio node failover engine
LAVENDE_ENABLED=true

# ── Spotify API Integration ───────────────────────────────────────
# Register your app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ── Discord Logging Webhooks (Optional) ───────────────────────────
# Discord Webhook URLs for real-time telemetry and audit logging
JOIN_LOG_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
LEAVE_LOG_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
MUSIC_LOG_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
COMMAND_LOG_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
ERROR_LOG_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
DASHBOARD_LOG_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
